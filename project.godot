[internationalization]

locale/translations=PackedStringArray("res://localization/items.vi.translation", "res://localization/items.en.translation", "res://localization/quests.vi.translation", "res://localization/quests.en.translation", "res://localization/questions.vi.translation", "res://localization/questions.en.translation")
