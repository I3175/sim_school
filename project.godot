[layer_names]

2d_physics/layer_1="world_solid"
2d_physics/layer_2="player"
2d_physics/layer_3="npc"
2d_physics/layer_4="monster"
2d_physics/layer_5="animal"
2d_physics/layer_6="interactable"
2d_physics/layer_7="hitbox_player"
2d_physics/layer_8="hitbox_monster"
2d_physics/layer_9="pickup"
2d_physics/layer_10="trigger"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.12, 0.18, 0.16, 1)
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
